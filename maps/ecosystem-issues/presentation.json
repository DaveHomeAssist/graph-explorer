{
  "title": "Sample: Issue Tracker",
  "eyebrow": "Graph Explorer · Synthetic Demo",
  "description": "Synthetic projects, issues, and recurring patterns for demonstrating the issue-tracker graph. No production or personal data.",
  "defaults": {
    "showHeatmap": false,
    "initialFocusMode": "All",
    "initialLayer": "All"
  },
  "layers": {
    "Tier 1": "#818cf8",
    "Tier 2": "#38bdf8",
    "P1 Issues": "#ef4444",
    "P2 Issues": "#f97316",
    "Issue Pattern": "#f59e0b"
  },
  "statusStyles": {
    "Clean": "#22c55e",
    "Active": "#818cf8",
    "At Risk": "#ef4444",
    "P1": "#ef4444",
    "P2": "#f59e0b"
  },
  "layerGlyphs": {
    "Tier 1": "T1",
    "Tier 2": "T2",
    "P1 Issues": "P1",
    "P2 Issues": "P2",
    "Issue Pattern": "PT"
  },
  "edgeStyles": {
    "has-issue": {
      "stroke": "rgba(239,68,68,0.45)",
      "dasharray": null
    },
    "matches-pattern": {
      "stroke": "rgba(245,158,11,0.5)",
      "dasharray": "6,3"
    },
    "affected-by": {
      "stroke": "rgba(245,158,11,0.3)",
      "dasharray": "4,4"
    }
  },
  "legendItems": [
    {
      "label": "Tier 1 Project",
      "color": "#818cf8"
    },
    {
      "label": "Tier 2 Project",
      "color": "#38bdf8"
    },
    {
      "label": "P1 Issue",
      "color": "#ef4444"
    },
    {
      "label": "P2 Issue",
      "color": "#f97316"
    },
    {
      "label": "Issue Pattern",
      "color": "#f59e0b"
    },
    {
      "label": "Clean",
      "color": "#22c55e"
    }
  ],
  "inspector": {
    "fields": [
      {
        "key": "type",
        "label": "Type"
      },
      {
        "key": "layer",
        "label": "Layer"
      },
      {
        "key": "status",
        "label": "Status"
      }
    ],
    "metaFields": [
      {
        "key": "desc",
        "label": "Description"
      }
    ],
    "metaArrays": [
      {
        "key": "risks",
        "label": "Open Risks",
        "emptyText": "No risks logged."
      },
      {
        "key": "nextMoves",
        "label": "Next Moves",
        "emptyText": "No next moves planned."
      }
    ],
    "metaChips": [
      "tags"
    ],
    "metaLink": null
  },
  "focusModes": [
    {
      "id": "All",
      "label": "All"
    },
    {
      "id": "p1-only",
      "label": "P1 Issues",
      "filter": {
        "layers": [
          "P1 Issues",
          "Issue Pattern"
        ]
      }
    },
    {
      "id": "p2-only",
      "label": "P2 Issues",
      "filter": {
        "layers": [
          "P2 Issues",
          "Issue Pattern"
        ]
      }
    },
    {
      "id": "at-risk",
      "label": "At Risk",
      "filter": {
        "ids": [
          "atlas-web",
          "web-101",
          "web-144"
        ]
      }
    },
    {
      "id": "patterns",
      "label": "Patterns",
      "filter": {
        "layers": [
          "Issue Pattern"
        ]
      }
    },
    {
      "id": "projects",
      "label": "Projects",
      "filter": {
        "layers": [
          "Tier 1",
          "Tier 2"
        ]
      }
    }
  ],
  "stats": [
    {
      "label": "Visible",
      "count": "visible"
    },
    {
      "label": "Projects",
      "filter": {
        "layers": [
          "Tier 1",
          "Tier 2"
        ]
      }
    },
    {
      "label": "P1",
      "filter": {
        "layer": "P1 Issues"
      }
    },
    {
      "label": "Patterns",
      "filter": {
        "layer": "Issue Pattern"
      }
    }
  ]
}
